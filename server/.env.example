# Local backend configuration for AI Research Copilot.
# Copy this file to server/.env and fill in ONE of the API keys below.

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Grok (xAI) ---
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4

# --- Groq (fast inference, Llama/GPT-OSS) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

PORT=8787
